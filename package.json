{
  "name": "bloods-hub-bot",
  "version": "1.0.0",
  "description": "Bot Discord + sito web per la gilda Bloods (WoW Pozzo dell'Eternità EU). 71 comandi slash, dashboard admin, BP/DKP loot system, raid management, M+, PvP.",
  "main": "src/index.js",
  "type": "commonjs",
  "keywords": ["discord", "bot", "wow", "world-of-warcraft", "guild", "raid", "dkp", "bloods-points", "nextjs", "express", "sequelize", "mysql"],
  "scripts": {
    "start": "node src/index.js",
    "deploy:commands": "node src/scripts/deploy-commands.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "test": "node tests/pipeline.js",
    "test:unit": "node tests/unit.test.js",
    "test:api": "node tests/api.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:smoke": "node tests/smoke.test.js",
    "test:all": "node tests/pipeline.js && node tests/unit.test.js && node tests/api.test.js && node tests/e2e.test.js",
    "backup": "node scripts/backup_db.js",
    "dev": "nodemon src/index.js",
    "dashboard:build": "cd dashboard && npm run build && cd .. && node scripts/generate-sitemap.js",
    "dashboard:dev": "cd dashboard && npm run dev",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "post-commit": "node scripts/post_commit.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.2",
    "axios": "^1.18.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "ms": "^2.1.3",
    "mysql2": "^3.9.7",
    "node-cron": "^3.0.3",
    "play-dl": "^1.9.7",
    "sequelize": "^6.37.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.35.4",
    "supertest": "^7.2.2"
  }
}
