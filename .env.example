# ─────────────────────────────────────────────────────────────
# Bloods Hub Bot — Environment configuration template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Discord application
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Main guild
GUILD_ID=your_guild_id_here

# Onboarding channel IDs
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
ROLE_PANEL_CHANNEL_ID=

# Admin role
ADMIN_ROLE_ID=

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bloods_hub_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DIALECT=mysql
DB_LOGGING=false

# External gaming APIs
STEAM_API_KEY=
BATTLE_NET_CLIENT_ID=
BATTLE_NET_CLIENT_SECRET=
RIOT_API_KEY=

# Misc
LOG_LEVEL=info
LOG_FORMAT=text
DEFAULT_LOCALE=it
ACTIVITY_TRACK_INTERVAL_MS=60000
LEADERBOARD_CACHE_TTL_MS=300000

# Dashboard
DASHBOARD_PORT=4567
DISCORD_CLIENT_SECRET=your_oauth_client_secret
JWT_SECRET=your_jwt_secret_min_32_chars
DASHBOARD_URL=https://your-domain.com
DASHBOARD_SECURE=true

# Health check server
HEALTH_PORT=3001

# Alert monitoring
ALERT_WEBHOOK_URL=
ALERT_CHANNEL_ID=

# Runtime
NODE_ENV=production

# Changelog & Updates channels
CHANGELOG_CHANNEL_ID=
UPDATES_CHANNEL_ID=

# Warcraft Logs API (optional)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_GUILD_NAME=Bloods
WCL_GUILD_SERVER=Pozzo dell'Eternità
WCL_REGION=EU

# Guilds of WoW API (optional — for roster/recruitment sync)
GOW_API_KEY=

# YouTube Data API v3 (optional — auto-post new videos + channel stats)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# TikTok (optional — auto-post new videos, API or scrape mode)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_USERNAME=
