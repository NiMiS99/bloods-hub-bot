# ─────────────────────────────────────────────────────────────
# Bloods Hub Bot — Environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Discord application
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-bot-application-id-here

# Main guild (the Bloods community server) — used for slash-command
# registration during development and for guild-scoped config caching.
GUILD_ID=your-guild-id-here

# Channel IDs (for auto-posting panels on startup)
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
ROLE_PANEL_CHANNEL_ID=

# Admin role (bypasses all permission checks)
ADMIN_ROLE_ID=

# Database (MySQL). Use a dedicated low-privilege user for the bot.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bloods_hub_db
DB_USER=bloods_bot
DB_PASSWORD=change-me
DB_DIALECT=mysql
DB_LOGGING=false

# External gaming APIs (all optional — only enable the games you support)
STEAM_API_KEY=
BATTLE_NET_CLIENT_ID=
BATTLE_NET_CLIENT_SECRET=
RIOT_API_KEY=

# Dashboard (Next.js + Express API)
DASHBOARD_PORT=4567
DASHBOARD_URL=http://localhost:4567
# Set to true if serving behind HTTPS (sets Secure flag on cookies)
DASHBOARD_SECURE=false
DISCORD_CLIENT_SECRET=your-oauth2-client-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-random-64-char-secret

# Health check server
HEALTH_PORT=3000

# Alert monitoring (optional — sends alerts to Discord on errors/crashes)
ALERT_WEBHOOK_URL=
ALERT_CHANNEL_ID=

# Logging
LOG_LEVEL=info
# Set to "json" for structured JSON console output (for log aggregation)
# Default: human-readable colored output
LOG_FORMAT=text

# Misc
DEFAULT_LOCALE=it
ACTIVITY_TRACK_INTERVAL_MS=60000
LEADERBOARD_CACHE_TTL_MS=300000
NODE_ENV=production
